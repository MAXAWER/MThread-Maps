rules_version = '2';
// База — только для сервера (кэш ответов 2ГИС): у служебного аккаунта функции доступ есть всегда,
// клиентам (приложению, браузеру) чтение и запись закрыты.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
