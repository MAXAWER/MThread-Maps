# Скопируйте в server/.env.local и заполните. Файл в git и в облако не попадает.
# Не называйте его server/.env: Firebase CLI выгрузил бы такие ключи открытыми переменными функции.
# В облаке ключи берутся из Secret Manager (firebase functions:secrets:set, см. README).

# auto — демо-данные, если нет DGIS_API_KEY; 1 — всегда демо; 0 — только реальные API
DEMO_MODE=auto

# 2ГИС: демо-ключ из Менеджера Платформы (platform.2gis.ru), затем ключ с лимитами
DGIS_API_KEY=
DGIS_DEMO_KEY=1
# Поля Places API — сверить со справочником в первый день
# DGIS_PLACE_FIELDS=items.point,items.full_address_name,items.rubrics,items.schedule,items.reviews,items.org,items.attribute_groups,items.contact_groups

# Jev (TypeSafe System One) через OpenRouter: ключ с openrouter.ai/keys.
# Адрес https://openrouter.ai/api и модель typesafe/jev-1.13 подставляются сами.
OPENROUTER_API_KEY=
# Либо прямой ключ TypeSafe (console.typesafe.ai) — он важнее OpenRouter.
# JEV_API_KEY=
# JEV_BASE_URL=https://api.typesafe.ai
# JEV_MODEL=jev-1.13.0

# Claude напрямую через Claude API: ключ из Claude Console (console.anthropic.com → API Keys)
ANTHROPIC_API_KEY=
ANSWER_MODEL=claude-haiku-5-5
PROFILE_MODEL=claude-haiku-5-5
TEXT_MODEL=claude-haiku-5-5
PLANNER_MODEL=claude-sonnet-5-5
PLANNER_EFFORT=medium
# Серверный fallback Sonnet 5.5 при отказе модели (beta server-side-fallback-2026-07-01)
PLANNER_FALLBACK=1

# OpenWeather One Call 3.0 (осадки по минутам). Open-Meteo работает без ключа.
OPENWEATHER_API_KEY=

# Подставной прогноз для тестовых сценариев, например {"precip_starts_in_min": 30}
WEATHER_OVERRIDE=

DAILY_SEARCH_LIMIT=60
DEBUG_LOGS=0
